# =========================
# Meshy (server-only)
# =========================
MESHY_API_KEY=your_meshy_api_key_here
NEXT_PUBLIC_MOCK_AI=true
# Number of colors requested for the multi-color 3MF. 1-16; 8 is a good first test.
MESHY_PRINT_MAX_COLORS=8
# Bambu filament preset suffix for YOUR printer, e.g. "@BBL A1", "@BBL P1P", "@BBL X1C".
# Meshy writes "@BBL X1C"; if that does not match the printer active in Bambu Studio,
# the project opens with all filaments reset to the default colour (whole model green).
BAMBU_FILAMENT_PROFILE_SUFFIX=@BBL X1C
# Public production base URL used to build Meshy webhook callbacks.
SITE_URL=https://your-production-domain.example
# Dedicated long random secret for Meshy callbacks. If omitted, CRON_SECRET is used as fallback.
MESHY_WEBHOOK_SECRET=replace-with-a-long-random-secret

# =========================
# NEW Shopify store only
# NEVER use credentials from another store here.
# =========================
SHOPIFY_STORE_DOMAIN=your-new-toy-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your_private_storefront_token
# Optional fallback:
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_token
# Easiest setup: the product handle. The backend resolves 10/15/20 cm variants itself.
SHOPIFY_PRODUCT_HANDLE=personalizirana-3d-figurka
# Optional fallback if you prefer fixed GIDs:
# SHOPIFY_VARIANT_10CM=gid://shopify/ProductVariant/000000000001
# SHOPIFY_VARIANT_15CM=gid://shopify/ProductVariant/000000000002
# SHOPIFY_VARIANT_20CM=gid://shopify/ProductVariant/000000000003

# Admin API token from a custom app (Settings > Apps > Develop apps) with scopes
# read_orders + write_fulfillments. Used only to create the fulfillment when a
# figure is marked SHIPPED so Shopify emails the customer the tracking number.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_api_token
# Optional; defaults to SHOPIFY_STOREFRONT_API_VERSION.
# SHOPIFY_ADMIN_API_VERSION=2026-07

# If the webhook is created in Shopify Admin > Settings > Notifications > Webhooks,
# paste the signing secret shown in that Webhooks section here.
SHOPIFY_WEBHOOK_SECRET=your_store_webhook_signing_secret
# App-managed webhooks can alternatively use:
# SHOPIFY_APP_CLIENT_SECRET=your_app_client_secret

# =========================
# NEW Supabase project only
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional; defaults to toy-assets.
SUPABASE_STORAGE_BUCKET=toy-assets

# =========================
# Internal production dashboard
# =========================
ADMIN_PASSWORD=use-a-long-unique-password
# Minimum 32 characters. Generate a random secret.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Fallback/internal sync authentication. Use another long random value.
CRON_SECRET=replace-with-another-long-random-secret

# =========================
# Operator alerts (Resend)
# =========================
RESEND_API_KEY=re_your_resend_api_key
ALERT_EMAIL_TO=you@example.com
# Must be a sender on a domain verified in Resend. Until then the default
# onboarding@resend.dev sender only delivers to the Resend account owner.
ALERT_EMAIL_FROM=POPME Alerts <alerts@your-domain.example>
# Minutes a project may sit in an automated stage before an alert (default 120).
WATCHDOG_STALE_MINUTES=120
